# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# contenu — vit dans le repo séparé pass-teny-content (repo git imbriqué)
/content/

# vercel
.vercel

# Freebuff desktop — base locale de l'app, à ne pas versionner ni surveiller (Turbopack panique sur les fichiers verrouillés)
.freebuff/
desktop-v2.db
desktop-v2.db-shm
desktop-v2.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts

# Cache local (index Passio persisté)
.cache/
