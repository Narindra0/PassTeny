# ============================================================
# Pass'Teny — Variables d'environnement
# Copier ce fichier en `.env.local` et remplir les valeurs.
# ============================================================

# ── Site ────────────────────────────────────────────────────
# URL publique du site (utilisée pour les OG images, sitemap…)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contenu (repo GitHub public pass-teny-content) ──────────
# Repo et branche servant le contenu canon (lyrics + annotations).
CONTENT_REPO=Narindra0/pass-teny-content
CONTENT_BRANCH=main
# En dev, le contenu est lu depuis le dossier local `content/`.
# En production, le contenu est lu depuis GitHub (raw + API).
# Forcez le mode GitHub en dev avec CONTENT_LOCAL=false.
# CONTENT_LOCAL=true

# ── Supabase (projet gratuit) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi…
# Réservée au serveur (API routes / server components) — jamais exposée.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi…

# ── GitHub (pipeline PR — phase 1) ──────────────────────────
# Token fine-grained (lecture+écriture sur pass-teny-content).
GITHUB_TOKEN=

# ── Seed (scripts uniquement) ───────────────────────────────
# API Pass'io utilisée pour récupérer les lyrics des albums gratuits.
PASSIO_API_BASE=https://pass-io.onrender.com
